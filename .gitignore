# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
*.ipynb_checkpoints/

# --- Virtual environment ---
urlEnv/
venv/
.venv/

# --- Secrets / local env ---
.env
.env.local
*.pem
*.key

# --- DVC internals (auto-managed, never commit) ---
.dvc/cache/
.dvc/tmp/
.dvc/config.local
# ^ config.local is where `dvc remote modify --local` writes
#   access_key_id / secret_access_key — must never be committed,
#   even though it's what you'll use to test the CI remote-auth
#   step locally before pushing.

# --- DVC-tracked data & model outputs ---
# `dvc repro`/`dvc add` auto-generate .gitignore entries inside these
# folders once they're tracked as pipeline outputs — these top-level
# lines are a backstop in case that hasn't happened yet for a fresh
# clone or a stage you re-run locally.
/data/raw/
/data/interim/
/data/processed/
/models/preprocessor.pkl
/models/model.pkl

# --- Local DVC remote stand-in ---
# This is your local_s3/ folder — a stand-in "bucket" on disk, not
# meant to be versioned in git (it's exactly what dvc push/pull move
# data into/out of).
local_s3/

# --- MLflow local artifacts ---
# Only created if MLflow ever falls back to local tracking (e.g. the
# tracking URI isn't reachable) — shouldn't exist given DagsHub is
# configured, but harmless to exclude.
mlruns/
mlartifacts/

# --- Logs ---
logs/
*.log

# --- Reports ---
# metrics.json is intentionally NOT ignored — dvc.yaml marks it
# `cache: false`, meaning DVC treats it as a plain git-tracked file
# (so `git diff`/`dvc metrics diff` can read it directly) rather than
# something pulled from the DVC remote. Don't add it here.
# feature_importance.csv and experiment_info.json ARE declared as
# regular `outs` in dvc.yaml, so DVC auto-gitignores them once
# `dvc repro` has run — no manual entry needed, listed here only for
# visibility:
# reports/feature_importance.csv
# reports/experiment_info.json

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Docker ---
*.tar

# --- Kubernetes / AWS local config (never commit) ---
kubeconfig
*.kubeconfig


notebooks/